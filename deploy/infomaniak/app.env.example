NODE_ENV=production
HOST=127.0.0.1
PORT=3000

DB_PATH=/srv/helbling-rapporte/db/rapporte.db
SESSIONS_DB_DIR=/srv/helbling-rapporte/db
SESSIONS_DB_NAME=sessions.db
CUSTOMER_PORTAL_SESSIONS_DB_NAME=customer-portal-sessions.db
UPLOADS_DIR=/srv/helbling-rapporte/uploads

# Beide Werte separat mit `openssl rand -hex 32` erzeugen.
SESSION_SECRET=
CUSTOMER_PORTAL_SESSION_SECRET=

CHROMIUM_PATH=/usr/bin/chromium
DISABLE_WATCHERS=1

# Nur tatsächlich verwendete Integrationen ergänzen. Geheimnisse nie in Git speichern.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ANTHROPIC_API_KEY=
