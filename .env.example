# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Sicherheit ─────────────────────────────────────────────────────────────
# Zufälligen langen String verwenden! z.B.: openssl rand -hex 32
SESSION_SECRET=bitte-aendern-langen-zufallsstring-einfuegen

# ── Datei-Uploads ──────────────────────────────────────────────────────────
# Standard: ./uploads (relativ zum Projektverzeichnis)
# Für Google Drive: Pfad zum Google Drive Ordner angeben
# Windows Beispiel: C:\Users\Benutzer\Google Drive\Helbling\uploads
# Mac Beispiel:     /Users/benutzer/Google Drive/Helbling/uploads
# Linux Beispiel:   /home/benutzer/GoogleDrive/Helbling/uploads
#UPLOADS_DIR=./uploads

# ── Google Drive Integration ───────────────────────────────────────────────
# Fotos und Anhänge werden automatisch in Google Drive hochgeladen.
# Ordner-ID: Ziel-Ordner in drive.google.com öffnen → letzter Teil der URL
GOOGLE_DRIVE_FOLDER_ID=ihre-ordner-id-hier

# Methode A: OAuth2 mit persönlichem Google-Konto (empfohlen, kein Workspace nötig)
# Einrichtung: node scripts/setup-drive-oauth.js
#GOOGLE_OAUTH_CLIENT_ID=123456789-abc.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
#GOOGLE_OAUTH_REFRESH_TOKEN=1//...

# Methode B: Service Account (nur für Google Workspace / Shared Drives)
# Achtung: Service Accounts haben kein Storage-Quota auf normalen "Meine Ablage"-Ordnern!
#GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# ── E-Mail (Microsoft 365 / Outlook) ──────────────────────────────────────
# Für Outlook/Microsoft 365:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rapport@ihre-firma.ch
SMTP_PASS=ihr-passwort-oder-app-passwort

# Für Gmail (alternativ):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ihre-adresse@gmail.com
# SMTP_PASS=ihr-app-passwort

# ── Lieferschein Auto-Import (Claude AI) ───────────────────────────────────────
# API-Key von https://console.anthropic.com/ → "API Keys"
# Ohne diesen Key ist der Ordner-Watcher deaktiviert.
ANTHROPIC_API_KEY=sk-ant-...
