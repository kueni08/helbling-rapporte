# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Sicherheit ─────────────────────────────────────────────────────────────
# Zufälligen langen String verwenden! z.B.: openssl rand -hex 32
SESSION_SECRET=bitte-aendern-langen-zufallsstring-einfuegen

# ── Datei-Uploads ──────────────────────────────────────────────────────────
# Standard: ./uploads (relativ zum Projektverzeichnis)
# Für Google Drive: Pfad zum Google Drive Ordner angeben
# Windows Beispiel: C:\Users\Benutzer\Google Drive\Helbling\uploads
# Mac Beispiel:     /Users/benutzer/Google Drive/Helbling/uploads
# Linux Beispiel:   /home/benutzer/GoogleDrive/Helbling/uploads
#UPLOADS_DIR=./uploads

# ── E-Mail (Microsoft 365 / Outlook) ──────────────────────────────────────
# Für Outlook/Microsoft 365:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rapport@ihre-firma.ch
SMTP_PASS=ihr-passwort-oder-app-passwort

# Für Gmail (alternativ):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ihre-adresse@gmail.com
# SMTP_PASS=ihr-app-passwort
