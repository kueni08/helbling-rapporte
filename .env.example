# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Sicherheit ─────────────────────────────────────────────────────────────
# Zufälligen langen String verwenden! z.B.: openssl rand -hex 32
SESSION_SECRET=bitte-aendern-langen-zufallsstring-einfuegen

# ── Datei-Uploads ──────────────────────────────────────────────────────────
# Ordner wo EML-Dateien gespeichert werden (Standard: ./uploads/email-inbox)
# Windows-Beispiel: C:\Users\Benutzer\OneDrive\Helbling\email-inbox
#UPLOADS_DIR=./uploads

# ── KI (Claude AI) ─────────────────────────────────────────────────────────
# API-Key von https://console.anthropic.com/ → "API Keys"
ANTHROPIC_API_KEY=sk-ant-...

# ── Microsoft Graph API (optional) ─────────────────────────────────────────
# Für automatisches Abrufen von Emails über Microsoft 365 (ohne IMAP)
# 1. Azure App registrieren: https://portal.azure.com → App registrations
# 2. API-Berechtigung: Mail.Read (Application)
# 3. Client Secret erstellen
# Diese Werte können auch in den Einstellungen im Browser konfiguriert werden.
#GRAPH_TENANT_ID=ihre-tenant-id
#GRAPH_CLIENT_ID=ihre-client-id
#GRAPH_CLIENT_SECRET=ihr-client-secret
#GRAPH_MAILBOX=info@ihre-firma.ch
#GRAPH_FOLDER=Inbox
#GRAPH_POLL_INTERVAL=300
#GRAPH_ENABLED=false
