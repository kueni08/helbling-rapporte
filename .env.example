# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Sicherheit ─────────────────────────────────────────────────────────────
# Zufälligen langen String verwenden! z.B.: openssl rand -hex 32
SESSION_SECRET=bitte-aendern-langen-zufallsstring-einfuegen

# ── Datei-Uploads ──────────────────────────────────────────────────────────
# Standard: ./uploads (relativ zum Projektverzeichnis)
# Für Google Drive: Pfad zum Google Drive Ordner angeben
# Windows Beispiel: C:\Users\Benutzer\Google Drive\Helbling\uploads
# Mac Beispiel:     /Users/benutzer/Google Drive/Helbling/uploads
# Linux Beispiel:   /home/benutzer/GoogleDrive/Helbling/uploads
#UPLOADS_DIR=./uploads

# ── Google Drive Integration ───────────────────────────────────────────────
# Fotos und Anhänge werden automatisch in Google Drive hochgeladen.
# 1. Service Account JSON-Datei unter credentials/service-account.json ablegen
# 2. Drive-Ordner mit Service Account E-Mail teilen (Bearbeiter-Rechte)
# 3. Ordner-ID aus der Drive-URL kopieren (letzter Teil der URL)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=ihre-ordner-id-hier

# ── E-Mail (Microsoft 365 / Outlook) ──────────────────────────────────────
# Für Outlook/Microsoft 365:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rapport@ihre-firma.ch
SMTP_PASS=ihr-passwort-oder-app-passwort

# Für Gmail (alternativ):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ihre-adresse@gmail.com
# SMTP_PASS=ihr-app-passwort

# ── Lieferschein Auto-Import + Email-Agent (Claude AI) ────────────────────────
# API-Key von https://console.anthropic.com/ → "API Keys"
# Wird für Lieferschein-Import UND Email-Agent benötigt.
ANTHROPIC_API_KEY=sk-ant-...

# ── Email-Agent (IMAP Posteingang) ─────────────────────────────────────────────
# Der Email-Agent liest automatisch neue E-Mails, klassifiziert sie mit Claude KI
# und erstellt daraus Kundenanfragen oder verknüpft sie mit bestehenden Aufträgen.
#
# Für Microsoft 365 / Outlook:
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@ihre-firma.ch
IMAP_PASS=ihr-passwort-oder-app-passwort
IMAP_FOLDER=INBOX
# Polling-Intervall in Sekunden (Standard: 300 = 5 Minuten)
IMAP_POLL_INTERVAL=300
#
# Für Gmail (alternativ):
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=ihre-adresse@gmail.com
# IMAP_PASS=ihr-app-passwort  (Gmail: App-Passwort in Google-Konto erstellen)
